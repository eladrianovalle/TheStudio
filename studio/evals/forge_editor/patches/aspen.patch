+def _worktree_top(directory: Path) -> str | None:
+    result = subprocess.run(
+        ["git", "rev-parse", "--show-toplevel"],
+        cwd=str(directory),
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0:
+        return None
+    return os.path.realpath(result.stdout.strip())
+
